# web-client/.env.local로 복사해 값을 채운다. 실제 값은 커밋하지 않는다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
KAKAO_LOGOUT_REDIRECT_URI=http://localhost:3000/login
SESSION_SECRET=32자-이상의-임의-문자열
# Supabase: Connect → Session pooler 주소(포트 5432). 로컬 Postgres는 끝에 ?sslmode=disable
DATABASE_URL=postgresql://postgres.<project-ref>:<비밀번호>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 선택: 직원 공유 링크(/s/<코드>) 베타. 1이 아니면 꺼짐
STAFF_SHARE_BETA=
